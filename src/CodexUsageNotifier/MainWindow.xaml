<Window x:Class="CodexUsageNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Codex Usage Notifier"
        Width="720"
        Height="700"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F5F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="14,7" Content="設定を開く" Click="OnOpenSettings" />
                    <TextBlock VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="Codex Usage Notifier" />
                </DockPanel>
                <TextBlock Margin="0,6,0,24"
                           Foreground="#5B6573"
                           Text="Phase 4C 利用枠監視 — Windows通知とGmail通知を独立して配送します。" />

                <Border Padding="22" Background="White" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="5時間枠" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FiveHourRateLimit}" />
                        <TextBlock Grid.Row="1" Margin="0,14,0,0" FontWeight="SemiBold" Text="週間枠" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WeeklyRateLimit}" />
                        <TextBlock Grid.Row="2" Margin="0,14,0,0" FontWeight="SemiBold" Text="利用可能リセットクレジット数" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Text="{Binding ResetCredits}" />
                        <TextBlock Grid.Row="3" Margin="0,14,0,0" FontWeight="SemiBold" Text="すべての利用枠" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" Text="{Binding AllRateLimits}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Margin="0,14,0,0" FontWeight="SemiBold" Text="利用枠別通知設定" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,14,0,0" Text="{Binding NotificationTarget}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Margin="0,14,0,0" FontWeight="SemiBold" Text="監視状態" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,14,0,0" Text="{Binding MonitoringStatus}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Margin="0,14,0,0" FontWeight="SemiBold" Text="最終取得" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,14,0,0" Text="{Binding LastSuccessfulFetch}" />
                        <TextBlock Grid.Row="7" Margin="0,14,0,0" FontWeight="SemiBold" Text="次回確認" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,14,0,0" Text="{Binding NextCheck}" />
                        <TextBlock Grid.Row="8" Margin="0,14,0,0" FontWeight="SemiBold" Text="Gmail通知" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,14,0,0" Text="{Binding GmailNotificationStatus}" />
                        <TextBlock Grid.Row="9" Margin="0,14,0,0" FontWeight="SemiBold" Text="Gmail認証" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,14,0,0" Text="{Binding GmailAuthenticationStatus}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="10" Margin="0,14,0,0" FontWeight="SemiBold" Text="Googleアカウント" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,14,0,0" Text="{Binding GmailAuthenticatedAccount}" />
                        <TextBlock Grid.Row="11" Margin="0,14,0,0" FontWeight="SemiBold" Text="最終Windows通知" />
                        <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,14,0,0" Text="{Binding LastWindowsNotification}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="12" Margin="0,14,0,0" FontWeight="SemiBold" Text="最終Gmail通知" />
                        <TextBlock Grid.Row="12" Grid.Column="1" Margin="0,14,0,0" Text="{Binding LastGmailNotification}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="13" Margin="0,14,0,0" FontWeight="SemiBold" Text="連続失敗" />
                        <TextBlock Grid.Row="13" Grid.Column="1" Margin="0,14,0,0" Text="{Binding ConsecutiveFailures}" />
                    </Grid>
                </Border>

                <Border Margin="0,18,0,0" Padding="18" Background="#E8F0FE" CornerRadius="8">
                    <TextBlock Foreground="#244A7C"
                               Text="この画面を閉じてもアプリは終了せず、タスクトレイに常駐します。終了はトレイメニューから行ってください。"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
