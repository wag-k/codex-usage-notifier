<Window x:Class="CodexUsageNotifier.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - Codex Usage Notifier"
        Width="900"
        Height="780"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,12,5" />
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#F3F5F7">
        <Border DockPanel.Dock="Bottom" Padding="18,12" Background="White" BorderBrush="#D7DCE2" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding OperationMessage}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="6,0" Padding="14,7" Content="初期値へ戻す" Click="OnRestoreDefaults" />
                    <Button Margin="6,0" Padding="14,7" Content="キャンセル" Click="OnCancel" />
                    <Button Margin="6,0" Padding="18,7" Content="保存" IsDefault="True"
                            IsEnabled="{Binding CanSave}" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="設定" />
                <TextBlock Margin="0,5,0,18" Foreground="#5B6573"
                           Text="変更は保存後、次の正常な利用枠取得から通知判定へ適用されます。" />

                <GroupBox Header="全般">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Windows通知" />
                        <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                  Content="Windows通知を有効にする" IsChecked="{Binding WindowsNotificationEnabled}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SectionLabel}" Text="通知禁止時間" />
                        <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                  Content="通知禁止時間を有効にする" IsChecked="{Binding QuietHoursEnabled}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="禁止時間（HH:mm）" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="100" Style="{StaticResource InputBox}"
                                         Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0" VerticalAlignment="Center" Text="～" />
                                <TextBox Width="100" Style="{StaticResource InputBox}"
                                         Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding QuietHoursError}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource SectionLabel}" Text="補助確認間隔（分）" />
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource InputBox}"
                                     Text="{Binding FallbackPollingMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FallbackPollingError}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Style="{StaticResource SectionLabel}" Text="Windowsログイン時" />
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <CheckBox VerticalAlignment="Center"
                                      Content="Windowsログイン時に自動起動する"
                                      IsChecked="{Binding AutoStartEnabled}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding AutoStartRegistrationStatus, StringFormat=OS登録状態：{0}}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding AutoStartWarning}" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="#5B6573"
                                   Text="開始時刻が終了時刻より後の場合は、日付をまたぐ通知禁止時間として扱います。" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="短期枠（FiveHour既定設定）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="短期枠回復通知" />
                        <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                  Content="有効にする" IsChecked="{Binding ShortWindowRecoveryEnabled}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SectionLabel}" Text="回復通知閾値（%）" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource InputBox}"
                                     Text="{Binding ShortWindowRecoveryThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ShortWindowThresholdError}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="長期枠（Weekly既定設定）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="通知種類" />
                        <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="有効" />
                        <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="残り時間（時間）" />
                        <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text="残量閾値（%）" />

                        <TextBlock Grid.Row="1" Style="{StaticResource SectionLabel}" Text="Early" />
                        <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LongWindowEarlyWarningEnabled}" />
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowEarlyWarningHours, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding EarlyHoursError}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowEarlyWarningThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding EarlyThresholdError}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="Standard" />
                        <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LongWindowStandardWarningEnabled}" />
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowStandardWarningHours, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StandardHoursError}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowStandardWarningThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StandardThresholdError}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource SectionLabel}" Text="Final" />
                        <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LongWindowFinalWarningEnabled}" />
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowFinalWarningHours, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FinalHoursError}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="3">
                            <TextBox Margin="4" Padding="6,4" Text="{Binding LongWindowFinalWarningThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FinalThresholdError}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Style="{StaticResource SectionLabel}" Text="リセット完了" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"
                                  Content="リセット完了通知を有効にする" IsChecked="{Binding LongWindowResetCompletedEnabled}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Gmail認証とテスト送信（Phase 4B）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="OAuthクライアント設定" />
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{Binding OAuthClientConfigurationStatus}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Foreground="#5B6573" Text="{Binding OAuthClientConfigurationPath}" TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left"
                                    Content="OAuthクライアント設定ファイルを選択" Click="OnSelectGoogleOAuthClient" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource SectionLabel}" Text="認証状態" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="{Binding GmailAuthenticationStatus}" />
                            <TextBlock Margin="0,4,0,0"><Run Text="アカウント: " /><Run Text="{Binding AuthenticatedGmailAddress, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0"><Run Text="最終認証成功: " /><Run Text="{Binding LastGmailAuthenticationAt, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0" Text="{Binding GmailReauthenticationStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="認証操作" />
                        <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,4">
                            <Button Margin="0,0,10,0" Padding="12,6" Content="Googleアカウントで認証する"
                                    IsEnabled="{Binding IsGmailAuthenticationAvailable}" Click="OnAuthenticateGmail" />
                            <Button Margin="0,0,10,0" Padding="12,6" Content="再認証"
                                    IsEnabled="{Binding IsGmailReauthenticationAvailable}" Click="OnReauthenticateGmail" />
                            <Button Padding="12,6" Content="認証解除"
                                    IsEnabled="{Binding IsGmailDisconnectAvailable}" Click="OnDisconnectGmail" />
                        </WrapPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource SectionLabel}" Text="送信先メールアドレス" />
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding GmailRecipient, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding GmailRecipientError}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Style="{StaticResource SectionLabel}" Text="テストメール" />
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <Button Padding="12,6" HorizontalAlignment="Left" Content="テストメール送信"
                                    IsEnabled="{Binding IsTestEmailAvailable}" Click="OnSendGmailTestMail" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding LastTestMailResult}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Style="{StaticResource SectionLabel}" Text="Gmail通知" />
                        <StackPanel Grid.Row="5" Grid.Column="1">
                            <CheckBox Content="Gmail通知を有効にする" IsEnabled="{Binding CanEnableGmailNotification}"
                                      IsChecked="{Binding GmailNotificationEnabled}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding GmailNotificationError}" />
                        </StackPanel>
                        <Border Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Padding="10" Background="#FFF8E1" CornerRadius="4">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Google認証、テストメール、本番の利用枠通知を利用できます。一時的なGmail送信失敗は60分後以降の正常監視で1回だけ再試行します。" />
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Header="取得済み利用枠">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" Foreground="#5B6573"
                                   Text="FiveHourとWeeklyには上の既定設定が適用されます。Unknownはこの画面から有効化できません。"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding RateLimits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="LimitId: " /><Run Text="{Binding LimitId}" />
                                                <Run Text=" / Position: " /><Run Text="{Binding Position}" />
                                                <Run Text=" / 期間: " /><Run Text="{Binding WindowDurationMinutes}" /><Run Text="分" />
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="Classification: " /><Run Text="{Binding Classification}" />
                                                <Run Text=" / 適用通知: " /><Run Text="{Binding AppliedNotifications}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding NotificationStatus}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Foreground="#5B6573" Text="利用枠をまだ取得していない場合、この一覧は空です。" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
