<Project>
  <PropertyGroup>
    <!-- Phase 5B以降のアプリ、App Serverクライアント、配布物で共有する唯一の既定バージョンです。 -->
    <VersionPrefix>0.5.2</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Product>Codex Usage Notifier</Product>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- ライセンス監査manifestと自己完結配布で使用する.NET 8 servicing版を一致させます。 -->
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
